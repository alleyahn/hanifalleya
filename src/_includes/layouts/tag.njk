---
layout: layouts/base.njk
---
<div class="content-container tag-page-container">
  <div class="tag-page-header">
    <h1>{{ tag }}</h1>
    <p class="tag-description">All content tagged with "{{ tag }}"</p>
  </div>
  
  <div class="tag-content-grid">
    {% set taggedItems = collections.taggedItems[tag] %}
    
    {% if taggedItems.length > 0 %}
      {% for item in taggedItems %}
        <article class="tag-content-card">
          <!-- Check if it's a gallery item (has image) -->
          {% if item.data.image %}
            <div class="tag-item-image">
              <img src="{{ item.data.image }}" alt="{{ item.data.alt or item.data.title }}">
            </div>
          {% endif %}
          
          <div class="tag-item-content">
            <h2>
              <a href="{{ item.url }}">{{ item.data.title }}</a>
            </h2>
            <p class="tag-item-date">{{ item.date | dateFormat }}</p>
            
            {% if item.data.excerpt %}
              <p class="tag-item-excerpt">{{ item.data.excerpt }}</p>
            {% endif %}
            
            <div class="tag-item-meta">
              <a href="{{ item.url }}" class="read-more">
                {% if item.data.image %}
                  View Image
                {% else %}
                  Read Post
                {% endif %}
                →
              </a>
            </div>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <div class="empty-tag-content">
        <p>No items found with this tag yet.</p>
      </div>
    {% endif %}
  </div>
  
  <div class="tag-navigation">
    <a href="/tags/" class="back-to-tags">← View All Tags</a>
  </div>
</div>