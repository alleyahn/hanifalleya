<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} @ {% endif %}{{ site.title }}</title>
  <link rel="stylesheet" href="/assets/css/main.css">
  
  <!-- Include desktop homepage styles only for the home page -->
  {% if bodyClass == 'desktop-home' %}
  <link rel="stylesheet" href="/assets/css/desktop.css">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mogra&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Sono:wght@200..800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Shantell+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Vibur&display=swap" rel="stylesheet">
</head>

<body{% if bodyClass %} class="{{ bodyClass }}{% if page.url != '/' %} scrollable-page{% endif %}"{% elif page.url != '/' %} class="scrollable-page"{% endif %}>

  <script src="/assets/js/site-name.js">
  
  // Copy button functionality for code blocks
document.addEventListener('DOMContentLoaded', function() {
  // Add click event to all code blocks
  const codeBlocks = document.querySelectorAll('.post-content pre');
  
  codeBlocks.forEach(block => {
    block.addEventListener('click', function(e) {
      // Only trigger if clicking the copy area (top-right)
      const rect = this.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;
      
      // Check if click is in top-right area (copy button zone)
      if (clickX > rect.width - 80 && clickY < 40) {
        const code = this.querySelector('code');
        const text = code ? code.textContent : this.textContent;
        
        // Copy to clipboard
        navigator.clipboard.writeText(text).then(() => {
          // Change button text temporarily
          const originalContent = this.style.getPropertyValue('--copy-text') || 'Copy';
          this.style.setProperty('--copy-text', '"Copied!"');
          
          // Reset after 2 seconds
          setTimeout(() => {
            this.style.setProperty('--copy-text', '"Copy"');
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy: ', err);
        });
      }
    });
    
    // Add copy cursor only in the copy button area
    block.addEventListener('mousemove', function(e) {
      const rect = this.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      
      if (mouseX > rect.width - 80 && mouseY < 40) {
        this.style.cursor = 'pointer';
      } else {
        this.style.cursor = 'default';
      }
    });
  });
});
  
  
  </script>

<!-- Clean Breadcrumb Navigation - Only show if not homepage -->
{% if page.url != '/' %}
<div class="breadcrumb-nav">
  <div class="breadcrumb-container">
    <a href="/" class="breadcrumb-link">Home</a>
    
    {% if page.url == '/blog/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">Blog</span>
    {% elif page.url == '/gallery/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">Postcards</span>
    {% elif page.url == '/tea/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">Tea</span>
    {% elif page.url == '/about/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">About</span>
    {% elif page.url == '/cv/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">CV</span>
    {% elif page.url == '/uses/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">Uses</span>
    {% elif page.url == '/now/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">Now</span>
    {% elif '/blog/' in page.url and page.url != '/blog/' %}
      <span class="breadcrumb-separator">></span>
      <a href="/blog/" class="breadcrumb-link">Blog</a>
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">{{ title }}</span>
    {% elif '/gallery/' in page.url and page.url != '/gallery/' %}
      <span class="breadcrumb-separator">></span>
      <a href="/gallery/" class="breadcrumb-link">Postcards</a>
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">{{ title }}</span>
    {% elif '/tea/' in page.url and page.url != '/tea/' %}
      <span class="breadcrumb-separator">></span>
      <a href="/tea/" class="breadcrumb-link">Tea</a>
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">{{ brand }} - {{ variant }}</span>
    {% elif '/tags/' in page.url and page.url == '/tags/' %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">Tags</span>
    {% elif '/tags/' in page.url and tag %}
      <span class="breadcrumb-separator">></span>
      <a href="/tags/" class="breadcrumb-link">Tags</a>
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">{{ tag }}</span>
    {% else %}
      <span class="breadcrumb-separator">></span>
      <span class="breadcrumb-current">{{ title }}</span>
    {% endif %}
  </div>
</div>
{% endif %}
  
  <!-- Main content -->
  {{ content | safe }}

  

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-left">
      <p>&copy; {{ site.name }} • 2025</p>
      <p>Made with ❤️ using <a href="https://www.11ty.dev/" target="_blank">Eleventy</a></p>
    </div>
  </div>
</footer>

</body>
</html>