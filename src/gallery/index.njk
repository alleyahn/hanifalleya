---
layout: layouts/base.njk
title: Postcards
---

<div class="gallery-container vertical-gallery">
  <div class="gallery-header">
    <h1>Postcard Collection</h1>
    <p class="gallery-description">Moments captured as postcards from my travels and everyday life. Open on desktop for best experience.</p>
  </div>
  
  <div class="postcard-gallery">
    {% if collections.gallery and collections.gallery.length > 0 %}
      {% for image in collections.gallery | reverse %}
        <div class="postcard" 
             data-index="{{ loop.index0 }}"
             data-title="{{ image.data.title }}"
             data-date="{{ image.date | dateFormat }}"
             data-location="{{ image.data.location }}"
             data-image="{{ image.data.image }}"
             data-emoji="{{ image.data.emoji or '🌍' }}"
             data-caption="{{ image.templateContent | striptags | trim }}">
          <div class="postcard-front">
            <div class="postcard-image-container">
              <img src="{{ image.data.image }}" alt="{{ image.data.alt or image.data.title }}">
            </div>
            <div class="postcard-overlay">
              {% if image.data.location %}
                <h3>{{ image.data.location }}</h3>
              {% else %}
                <h3>{{ image.data.title }}</h3>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="empty-gallery">
        <p>No postcards in your collection yet.</p>
      </div>
    {% endif %}
  </div>
</div>

<!-- Postcard Modal -->
<div class="postcard-modal">
  <div class="modal-close">×</div>
  <div class="modal-navigation modal-prev">←</div>
  <div class="modal-navigation modal-next">→</div>
  
  <div class="postcard-modal-content">
    <div class="postcard-modal-card">
      <!-- Front of the postcard (image) -->
      <div class="postcard-modal-front">
        <div class="postcard-modal-image-container">
          <img src="" alt="" class="postcard-modal-image">
        </div>
        <div class="postcard-modal-title"></div>
      </div>
      
      <!-- Back of the postcard (message) -->
      <div class="postcard-modal-back">
        <div class="postcard-modal-back-top">
          <div class="postcard-modal-date"></div>
          <div class="postcard-modal-postage">
            <span class="emoji"></span>
          </div>
        </div>
        <div class="postcard-modal-back-bottom">
          <div class="postcard-modal-message"></div>
          <div class="postcard-modal-signature">
            <div class="postcard-modal-greeting">Greetings from {{ image.data.location or "my travels" }}!</div>
            <div class="postcard-modal-name">Alleya</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Elements
    const postcards = document.querySelectorAll('.postcard');
    const modal = document.querySelector('.postcard-modal');
    const modalClose = document.querySelector('.modal-close');
    const modalContent = document.querySelector('.postcard-modal-content');
    const modalCard = document.querySelector('.postcard-modal-card');
    const modalImage = document.querySelector('.postcard-modal-image');
    const modalTitle = document.querySelector('.postcard-modal-title');
    const modalFront = document.querySelector('.postcard-modal-front');
    const modalBack = document.querySelector('.postcard-modal-back');
    const modalPostage = document.querySelector('.postcard-modal-postage .emoji');
    const modalDate = document.querySelector('.postcard-modal-date');
    const modalMessage = document.querySelector('.postcard-modal-message');
    const modalGreeting = document.querySelector('.postcard-modal-greeting');
    const modalPrev = document.querySelector('.modal-prev');
    const modalNext = document.querySelector('.modal-next');
    
    let currentIndex = 0;
    let showingBack = false;
    
    // Postcard modal functionality
    function openPostcard(postcard) {
      const index = parseInt(postcard.getAttribute('data-index'));
      currentIndex = index;
      showingBack = false;
      
      // Update postcard front content from data attributes
      modalImage.src = postcard.getAttribute('data-image');
      modalImage.alt = postcard.getAttribute('data-title');
      modalTitle.textContent = postcard.getAttribute('data-title');
      
      // Update postcard back content
      modalPostage.textContent = postcard.getAttribute('data-emoji');
      modalDate.textContent = postcard.getAttribute('data-date');
      modalMessage.textContent = postcard.getAttribute('data-caption');
      
      // Location specific greeting
      const location = postcard.getAttribute('data-location');
      if (location && location !== 'null' && location !== 'undefined') {
        modalGreeting.textContent = `Greetings from ${location}!`;
      } else {
        modalGreeting.textContent = 'Greetings!';
      }
      
      // Show front of postcard
      modalFront.style.display = 'block';
      modalBack.style.display = 'none';
      
      // Update navigation visibility
      updateNavigation();
      
      // Show modal
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    
    function closePostcard() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
    
    function flipPostcard() {
      if (showingBack) {
        // Show front
        modalBack.style.display = 'none';
        modalFront.style.display = 'block';
        showingBack = false;
      } else {
        // Show back
        modalFront.style.display = 'none';
        modalBack.style.display = 'flex';
        showingBack = true;
      }
    }
    
    function updateNavigation() {
      // Update navigation visibility
      if (currentIndex === 0) {
        modalPrev.style.visibility = 'hidden';
      } else {
        modalPrev.style.visibility = 'visible';
      }
      
      if (currentIndex === postcards.length - 1) {
        modalNext.style.visibility = 'hidden';
      } else {
        modalNext.style.visibility = 'visible';
      }
    }
    
    function prevPostcard() {
      if (currentIndex > 0) {
        currentIndex--;
        updatePostcardContent(postcards[currentIndex]);
      }
    }
    
    function nextPostcard() {
      if (currentIndex < postcards.length - 1) {
        currentIndex++;
        updatePostcardContent(postcards[currentIndex]);
      }
    }
    
    function updatePostcardContent(postcard) {
      // Reset to front view
      showingBack = false;
      modalFront.style.display = 'block';
      modalBack.style.display = 'none';
      
      // Update content
      modalImage.src = postcard.getAttribute('data-image');
      modalImage.alt = postcard.getAttribute('data-title');
      modalTitle.textContent = postcard.getAttribute('data-title');
      
      modalPostage.textContent = postcard.getAttribute('data-emoji');
      modalDate.textContent = postcard.getAttribute('data-date');
      modalMessage.textContent = postcard.getAttribute('data-caption');
      
      // Location specific greeting
      const location = postcard.getAttribute('data-location');
      if (location && location !== 'null' && location !== 'undefined') {
        modalGreeting.textContent = `Greetings from ${location}!`;
      } else {
        modalGreeting.textContent = 'Greetings!';
      }
      
      updateNavigation();
    }
    
    // Event listeners for postcard interaction
    postcards.forEach(postcard => {
      postcard.addEventListener('click', function() {
        openPostcard(this);
      });
    });
    
    modalClose.addEventListener('click', closePostcard);
    
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        closePostcard();
      }
    });
    
    modalCard.addEventListener('click', function(e) {
      // Only flip if clicking on the card itself, not navigation buttons
      if (e.target !== modalPrev && e.target !== modalNext && e.target !== modalClose) {
        flipPostcard();
      }
    });
    
    modalPrev.addEventListener('click', function(e) {
      e.stopPropagation(); // Prevent card flip
      prevPostcard();
    });
    
    modalNext.addEventListener('click', function(e) {
      e.stopPropagation(); // Prevent card flip
      nextPostcard();
    });
    
    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (!modal.classList.contains('active')) return;
      
      if (e.key === 'Escape') {
        closePostcard();
      } else if (e.key === 'ArrowLeft') {
        prevPostcard();
      } else if (e.key === 'ArrowRight') {
        nextPostcard();
      } else if (e.key === ' ' || e.key === 'Enter') {
        flipPostcard();
      }
    });
  });
</script>