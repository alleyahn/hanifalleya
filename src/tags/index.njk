---
layout: layouts/base.njk
title: Tags
---

<div class="content-container tags-page-container">
  <div class="tags-page-header">
    <h1>All Tags</h1>
    <p class="tags-description">Browse content by topic. Click any tag to see related posts and images.</p>
  </div>
  
  <div class="tags-grid">
    {% for tag in collections.tagList %}
      {% if tag != "blog" and tag != "gallery" %}
        {% set taggedItems = collections.taggedItems[tag] %}
        <a href="/tags/{{ tag | slug }}/" class="tag-card">
          <div class="tag-name">{{ tag }}</div>
          <div class="tag-count">{{ taggedItems.length }} item{% if taggedItems.length != 1 %}s{% endif %}</div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  
  {% if collections.tagList.length == 0 %}
    <div class="empty-tags">
      <p>No tags found yet. Tags will appear here as you add them to your posts and images.</p>
    </div>
  {% endif %}
</div>